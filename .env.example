# Copy to .env and fill in. Never commit .env.

# --- LLM provider: gemini | anthropic ---
LLM_PROVIDER=gemini
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=60

# --- Gemini (used when LLM_PROVIDER=gemini) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded or times out
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# --- Claude (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, slower, costlier)
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
CLAUDE_TIMEOUT_SECONDS=120
# Server-side retry on another model if a request is declined (Claude API only)
CLAUDE_ENABLE_FALLBACKS=true

# --- Embeddings / chunking / retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6
RELEVANCE_THRESHOLD=0.25
HISTORY_TURNS=6

# --- Storage ---
# Fixed knowledge base: answer only from the files in KNOWLEDGE_BASE_DIR (indexed at startup);
# no uploads, deletes or re-indexing. Set to false to manage documents from the dashboard.
KB_READ_ONLY=true
KNOWLEDGE_BASE_DIR=knowledge_base
VECTORSTORE_DIR=vectorstore
CHROMA_COLLECTION=company_knowledge
MAX_UPLOAD_MB=25

# --- Servers ---
API_HOST=127.0.0.1
API_PORT=8000
# Leave empty (or set to 'embedded') to run the API inside the Streamlit process - required on
# Streamlit Community Cloud. Set to the API URL when you run main.py / start.sh separately.
BACKEND_URL=http://127.0.0.1:8000

# Quieter logs / no telemetry
ANONYMIZED_TELEMETRY=False
TOKENIZERS_PARALLELISM=false
